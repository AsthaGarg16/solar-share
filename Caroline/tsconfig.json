{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*"]
    },
    "typeRoots": ["node_modules/@types"]
  },
  "include": [
    "./scripts/**/*.ts", 
    "./test/**/*.ts", 
    "./typechain-types/**/*.ts", 
    "./hardhat.config.ts"
  ],
  "exclude": ["node_modules"]
}