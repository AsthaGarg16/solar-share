---
config:
  look: classic
  flowchart:
    padding: 14
---
flowchart TD

    RESERVE["<b>MAINTENANCE RESERVE</b><br>RevenueDistributor<br>5% of every waterfall"]

    subgraph Phase1["PROPOSAL"]
        A["<b>PROPOSAL SUBMITTED</b><br>MaintenanceDAO<br>Any token holder · amount · vendor"]
    end

    subgraph Phase2["VOTING  (7-day window)"]
        B["<b>VOTING OPEN</b><br>MaintenanceDAO<br>1 share = 1 vote"]
        C{"7 days<br>elapsed?"}
    end

    subgraph Phase3["EXECUTION"]
        D["<b>EXECUTE PROPOSAL</b><br>MaintenanceDAO<br>→ WeatherOracle.getRainyDays()"]
        E{"Rainy days<br>≥ 15?"}
        F["<b>PARAMETRIC AUTO-APPROVAL</b><br>WeatherOracle<br>Act of God — bypasses quorum"]
        G{"yesVotes ><br>50% of shares?"}
        H["<b>PROPOSAL PASSED</b><br>MaintenanceDAO"]
        I["<b>PROPOSAL REJECTED</b><br>Reserve preserved"]
    end

    subgraph Phase4["PAYOUT"]
        J["<b>FUNDS RELEASED TO VENDOR</b><br>RevenueDistributor<br>withdrawMaintenance()"]
    end

    END1(["Vendor Paid"])
    END2(["Rejected — Resubmit"])

    RESERVE --> A
    A --> B
    B --> C
    C -- "Not yet" --> B
    C -- "Deadline passed" --> D
    D --> E
    E -- "Yes — extreme weather" --> F
    E -- "No — standard vote" --> G
    F --> J
    G -- "Passed" --> H
    G -- "Rejected" --> I
    H --> J
    J --> END1
    I --> END2

    classDef reserve fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20
    classDef phase2 fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#bf360c
    classDef phase3 fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#4a148c
    classDef phase4 fill:#b2dfdb,stroke:#004d40,stroke-width:2px,color:#004d40
    classDef decision fill:#fff9c4,stroke:#f57f17,stroke-width:2px,color:#e65100
    classDef terminal fill:#c8e6c9,stroke:#388e3c,stroke-width:2px,color:#1b5e20
    classDef rejected fill:#ffcdd2,stroke:#b71c1c,stroke-width:2px,color:#b71c1c

    class RESERVE,A reserve
    class B phase2
    class D,E,F,G,H,I phase3
    class J phase4
    class C,E,G decision
    class END1 terminal
    class END2,I rejected
