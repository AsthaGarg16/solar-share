{
  "private": true,
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,css,md}": ["prettier --write"],
    "backend/**/*.sol": ["sh -c 'cd backend && forge fmt'"]
  }
}
